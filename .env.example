# Shorted — copy to .env and fill in. .env is gitignored.
# No key in this file may ever be prefixed EXPO_PUBLIC_ / NEXT_PUBLIC_: that
# ships it in the client bundle. All model and database credentials are
# server-side only.

ANTHROPIC_API_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail receipt ingestion (PROMPT.md §3.2). Read-only scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/google/callback
