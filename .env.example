# Shorted — copy to .env and fill in. .env is gitignored.
#
# No key in this file may ever be prefixed EXPO_PUBLIC_ / NEXT_PUBLIC_ / VITE_ /
# REACT_APP_: that inlines it into the client bundle. services/secrets.ts checks
# this at startup and the process refuses to boot if a credential carries one, so
# the rule is enforced rather than documented.
#
# SUPABASE_ANON_KEY is the one publishable value here. It grants nothing beyond
# what RLS allows, which is why application code uses it (see services/db.ts).

ANTHROPIC_API_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=

# BYPASSES RLS. Reachable only through services/db.ts adminDb(<reason>), whose
# reasons are an enumerated union — grep ServiceReason to see every place in the
# codebase that can read across users. Do not add a caller without a review.
SUPABASE_SERVICE_ROLE_KEY=

# 32 bytes of base64. Encrypts Google refresh tokens at rest with AES-256-GCM.
# Deliberately NOT a Supabase credential: a Postgres dump or a leaked
# service-role key must not also hand over live inbox access.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Gmail receipt ingestion (PROMPT.md §3.2). Read-only scope.
# The per-user refresh token is NOT configured here — it is written encrypted to
# gmail_ingest_consents.refresh_token_encrypted by the OAuth callback, and read
# back only inside ingestGmailReceipts(). It is never a CLI argument.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/google/callback
